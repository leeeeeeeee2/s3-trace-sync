{
  "name": "s3-trace-sync",
  "version": "0.1.0",
  "description": "OpenRouter-style conversation trace sync and observability dashboard for Magpie Gateway — Cloudflare R2 (preferred) and S3-compatible storage with zero external dependencies.",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "s3-trace-sync.hooks.mjs",
    "src",
    "page",
    "static",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20",
    "magpie": ">=0.1.1340"
  },
  "keywords": [
    "magpie",
    "magpie-plugin",
    "magpie-page",
    "magpie-gateway",
    "cloudflare-r2",
    "r2",
    "s3",
    "openrouter",
    "observability",
    "tracing",
    "logs"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeeeeeeee2/s3-trace-sync.git"
  },
  "homepage": "https://github.com/leeeeeeeee2/s3-trace-sync#readme",
  "bugs": {
    "url": "https://github.com/leeeeeeeee2/s3-trace-sync/issues"
  },
  "magpie": {
    "name": "S3 Trace Sync",
    "summary": {
      "en": "OpenRouter-style Logs, Activity, Sessions, and S3 Broadcast for Magpie conversations — Cloudflare R2 preferred, zero external dependencies, native AWS SigV4, Input/Output logging, privacy controls, and built-in dashboard."
    },
    "hooks": "./s3-trace-sync.hooks.mjs",
    "page": {
      "title": "S3 Trace Sync",
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3483,
        "option": "port"
      },
      "keepAlive": false
    },
    "permissions": [],
    "options": {
      "enabled": false,
      "provider": "r2",
      "accountId": "",
      "r2Jurisdiction": "default",
      "bucket": "magpie-traces",
      "region": "auto",
      "endpoint": "",
      "storageClass": "STANDARD",
      "accessKeyId": "",
      "secretAccessKey": "",
      "folder": "openrouter-traces",
      "prefix": "openrouter-traces",
      "pathTemplate": "{folder}/{date}",
      "exportMode": "single",
      "batchMaxItems": 20,
      "batchFlushIntervalMs": 10000,
      "tracePreset": "common",
      "traceFields": {
        "timestamps": true,
        "session": true,
        "routing": true,
        "status": true,
        "timing": true,
        "usage": true,
        "modelParameters": true,
        "systemPrompt": true,
        "inputMessages": true,
        "outputMessages": true,
        "reasoning": true,
        "toolCalls": true,
        "rawRequest": true,
        "rawResponse": false,
        "rawUsage": true,
        "customMetadata": true,
        "otelObservations": true
      },
      "inputOutputLogging": true,
      "privacyMode": false,
      "stripMultimodal": true,
      "redactSecrets": true,
      "captureErrors": true,
      "captureRemote": false,
      "skipSubagents": false,
      "includedApiKeys": [],
      "excludedApiKeys": [],
      "skipAgents": [],
      "excludedModels": [],
      "localCache": true,
      "maxLocalTraces": 500,
      "s3TimeoutMs": 8000,
      "gatewayTimeoutMs": 10000,
      "port": 3483
    },
    "icon": "data:image/svg+xml;base64,"
  }
}
